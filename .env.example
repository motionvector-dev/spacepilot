# LTX-Video Local API Bridge Environment Variables
# Copy this file to .env and adjust the values as needed.

# Hugging Face Authenticated Token (Required to bypass rate limits when downloading models)
# HF_TOKEN="your_huggingface_token_here"

# Toggle Mock Video Mode (default: true for instant startup & fast testing without downloading 40GB models)
MOCK_VIDEO=true

# Choose LTX Model Size:
# - "2b"  (fast, ~4 GB VRAM)
# - "13b" (high quality, ~39 GB VRAM, default distilled LTX model)
LTX_MODEL=2b

# Compute device override: "cuda", "mps", or "cpu". 
# If left blank, it will auto-detect CUDA, MPS, or CPU in order of preference.
# DEVICE=mps

# API Server Port (default: 8000)
PORT=8000
