# SpacePilot environment reference
#
# Secrets live in Doppler, not in a .env file. This repo sits under the
# `unfoundbox` project (config `dev_personal`), scoped at ~/code, so the CLI
# picks it up here with no per-repo setup:
#
#   doppler run -- spacepilot studio
#   doppler run -- python spacepilot/web_api.py
#   doppler run -- python -m pytest tests/ -q
#
# Check what is wired up with:  doppler configure
#
# Copy this file to .env only for the non-secret tunables below, and only if
# you are not launching through `doppler run`. .env is gitignored.


# ─── Secrets: set these in Doppler, never here ──────────────────────────────

# LOCAL_WORKER_TOKEN  (REQUIRED)
#   Shared secret between the Mac and the GPU worker. src/ltx_worker.py exits
#   rather than start without it, and `spacepilot launch` refuses to start a billing
#   instance it could not then deploy to. Not yet in Doppler — add it there:
#     doppler secrets set LOCAL_WORKER_TOKEN="$(openssl rand -hex 32)"
#
# HF_TOKEN
#   Hugging Face token for model downloads. Already in Doppler.


# ─── Studio API (spacepilot/web_api.py) ───────────────────────────────────

# Port for the studio server. Binds 127.0.0.1 only.
SPACEPILOT_STUDIO_PORT=8088

# Where generated media is written and served from. The test suite points this
# at a temp dir so runs never touch the real asset library.
# SPACEPILOT_OUTPUTS_DIR=/absolute/path/to/outputs

# Ceiling on any single ffmpeg invocation, in seconds.
PLUTO_FFMPEG_TIMEOUT=3600

# Interpreter used to launch the studio from the CLI. `spacepilot` runs the CLI
# under bare python3, which usually lacks fastapi. Resolution order is
# SPACEPILOT_PYTHON, then "python_bin" in .spacepilot_config.json, then sys.executable.
# SPACEPILOT_PYTHON=/path/to/env/bin/python


# ─── Audio generation ───────────────────────────────────────────────────────

# Kokoro weights for POST /api/generate/voice. Runs in-process via onnxruntime;
# no server needed. Unset, the paths come from KokoroDriver().asset_paths() —
# there are no other fallback directories; the ../sr-lessons and
# ~/.cache/hyperframes ones this file used to name were removed with the driver
# rewrite.
# SPACEPILOT_KOKORO_MODEL=/absolute/path/to/kokoro-v1.0.onnx
# SPACEPILOT_KOKORO_VOICES=/absolute/path/to/voices-v1.0.bin

# Local MLX server, used by POST /api/generate/music and by voice when
# backend=mlx. Start it with:
#   mlx-serve serve --host 127.0.0.1 --port 11234 --skip-mem-preflight
MLX_SERVE_URL=http://127.0.0.1:11234
PLUTO_MUSIC_MODEL=ddalcu/MiniMax-Music3-MLX-Serve-8bit
PLUTO_VOICE_MODEL=kokoro


# ─── GPU worker (src/ltx_worker.py, runs on the EC2 box) ────────────────────

LTX_WORKER_HOST=0.0.0.0
LTX_WORKER_PORT=5000
LTX_OUTPUT_DIR=/scratch/out


# ─── Legacy bridge (src/server.py) ──────────────────────────────────────────
# Superseded by web_api.py; kept for the older LTX-Video API bridge.

MOCK_VIDEO=true
LTX_MODEL=2b
PORT=8000
# DEVICE=mps
